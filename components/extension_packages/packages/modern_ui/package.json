        "ManagerMixin",
        "LegacyFrameMixin"
      ],
      "injectors": {
        "defaultRequire": 1
      }
    },
    "mixins/modern_ui-forge.json": {
      "required": true,
      "minVersion": "0.8",
      "package": "io.github.recrivenvi.extensions.modernui.nativebridge.mixin",
