{
  "name": "@recrivenvi/minecraft-protocol-companion",
  "version": "0.0.1-phase8",
  "private": true,
  "type": "module",
  "description": "Independent MCP companion for the Mine-Craft-Protocol Runtime.",
  "bin": {
    "minecraft-protocol-mcp": "./dist/index.js"
  },
  "scripts": {
    "protocol:check": "node ./scripts/check-protocol.mjs",
    "build": "npm run protocol:check && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "conformance:live": "npm run build && node ./dist/live-conformance.js",
    "start": "node ./dist/index.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.10.0",
    "typescript": "7.0.2"
  }
}
