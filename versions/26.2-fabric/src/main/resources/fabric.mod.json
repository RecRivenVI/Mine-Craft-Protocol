{
  "schemaVersion": 1,
  "id": "minecraft_protocol_probe",
  "version": "${version}",
  "name": "Minecraft Protocol Probe",
  "description": "Phase 8 V1 release-hardening Runtime for Mine-Craft-Protocol.",
  "authors": [
    "RecRivenVI"
  ],
  "license": "All Rights Reserved",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.recrivenvi.minecraftprotocol.probe.FabricProbeMod"
    ],
    "client": [
      "io.github.recrivenvi.minecraftprotocol.probe.FabricClientProbeMod"
    ]
  },
  "mixins": [
    {
      "config": "minecraft_protocol_probe.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "minecraft": "~26.2",
    "java": ">=25"
  }
}
