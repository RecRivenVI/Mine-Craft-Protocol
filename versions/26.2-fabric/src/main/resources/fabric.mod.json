{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "environment": "${fabric_environment}",
  "entrypoints": {
    "main": [
      "io.github.recrivenvi.minecraftprotocol.probe.FabricProbeMod"
    ],
    "client": [
      "io.github.recrivenvi.minecraftprotocol.probe.FabricClientProbeMod"
    ]
  },
  "mixins": [
    {
      "config": "minecraft_protocol_probe.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}"
  }
}
