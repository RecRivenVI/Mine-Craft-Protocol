{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [
        "${mod_authors}"
    ],
    "license": "${mod_license}",
    "environment": "${fabric_environment}",
    "accessWidener": "minecraft_protocol_probe.accesswidener",
    "entrypoints": {
        "main": [
            "${mod_group}.probe.FabricProbeMod"
        ],
        "client": [
            "${mod_group}.probe.FabricClientProbeMod"
        ]
    },
    "mixins": [
        "minecraft_protocol_probe.server.mixins.json",
        {
            "config": "minecraft_protocol_probe.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=${loader_minimum}",
        "fabric-api": "*",
        "minecraft": "~${minecraft_version}",
        "java": ">=${java_version}"
    }
}
