{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [
        "${mod_authors}"
    ],
    "license": "${mod_license}",
    "environment": "${fabric_environment}",
    "accessWidener": "mine_craft_protocol.accesswidener",
    "entrypoints": {
        "main": [
            "${mod_group}.FabricProtocolMod"
        ],
        "client": [
            "${mod_group}.FabricClientProtocolMod"
        ],
        "preLaunch": [
            "${mod_group}.loader.ExtensionPreLaunch"
        ],
        "modmenu": [
            "${mod_group}.client.ProtocolModMenu"
        ]
    },
    "mixins": [
        "mine_craft_protocol.server.mixins.json",
        {
            "config": "mine_craft_protocol.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=${loader_minimum}",
        "fabric-api": "*",
        "minecraft": "~${minecraft_version}",
        "java": ">=${java_version}"
    },
    "suggests": {
        "modmenu": "*"
    }
}
